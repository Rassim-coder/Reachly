# Supabase — copy this file to `.env` and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# The publishable key is safe to expose to the browser; access control is
# enforced by Row Level Security. Never add a service-role key with a
# NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production: set this to your real origin (e.g. https://reachly.example.com).
# Supabase auth email-redirect links use this value; when unset, the request
# Origin header is used as a fallback. The localhost value below is only for
# local development and must not be left active in production.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose this to the browser. Required for privileged
# server operations that bypass RLS, such as upserting shared business records
# when a user saves a lead.
SUPABASE_SERVICE_ROLE_KEY=
