# Supabase — copy this file to `.env` and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# The publishable key is safe to expose to the browser; access control is
# enforced by Row Level Security. Never add a service-role key with a
# NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production: set this to your real origin (e.g. https://reachly.example.com).
# Supabase auth email-redirect links use this value; when unset, the request
# Origin header is used as a fallback. The localhost value below is only for
# local development and must not be left active in production.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only and not required by the current application. The lead-saving flow
# uses an authenticated, narrowly scoped database function instead. Only set
# this if a future server feature explicitly requires service-role access.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Groq API credentials for Reachly AI features.
# Override the model ID if it is not available in your GroqCloud account.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional model for AI template drafts (defaults to qwen/qwen3.8-27b).
TEMPLATE_AI_MODEL=qwen/qwen3.8-27b

# Maximum AI template generations per user per UTC day (1–100; defaults to 20).
TEMPLATE_AI_DAILY_LIMIT=20
